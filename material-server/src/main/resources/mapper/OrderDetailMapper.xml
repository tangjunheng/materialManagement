<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.material.mapper.user.OrderDetailMapper">

    <insert id="insertBatch">
        insert into order_detail (name, image, order_id, material_id, setmeal_id, number)
            values
        <foreach collection="orderDetailList" item="od" separator=",">
            (#{od.name},#{od.image},#{od.orderId},#{od.materialId},#{od.setmealId},#{od.number})
        </foreach>
    </insert>
    <update id="returnMaterials" parameterType="java.util.List">
        update order_detail
        <trim prefix="SET" suffixOverrides=",">
            number = CASE id
            <foreach collection="list" item="item" index="index">
                WHEN #{item.id} THEN #{item.number}
            </foreach>
            ELSE number
            END
        </trim>
        WHERE id IN
        <foreach collection="list" item="item" open="(" separator="," close=")">
            #{item.id}
        </foreach>
    </update>
</mapper>
